<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for Prism.app. scripts/build_app.sh replaces __VERSION__ and __BUILD__.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Prism</string>
	<key>CFBundleExecutable</key>
	<string>Prism</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.goveaaron.PrismLighting</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Prism</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>Prism — studio lighting for everyone.</string>

	<!-- Privacy strings (shown by macOS the first time each feature is used) -->
	<key>NSCameraUsageDescription</key>
	<string>Prism uses your camera to find your lights, check that colors look right, and confirm looks you ask the assistant for. Video never leaves your Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Prism can listen to a microphone for Music Mode and for voice commands like “warm up the background a bit”.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Prism turns what you say (“bring the fill down a little”) into lighting changes.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Prism listens to the music playing on this Mac (Spotify, YouTube, Apple Music…) so your lights can move with it. Audio never leaves your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Prism lets phones and tablets on your network control the lights (scan the QR code), and can talk to Art-Net and sACN lighting nodes.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_prism-lights._tcp</string>
		<string>_http._tcp</string>
		<string>_osc._udp</string>
	</array>
	<key>NSAppleEventsUsageDescription</key>
	<string>Prism can read the song that’s playing in Spotify or Music to choose a matching lighting mood.</string>

	<!-- Project documents -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Prism Lighting Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeIconFile</key>
			<string>AppIcon</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.goveaaron.prism.project</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.goveaaron.prism.project</string>
			<key>UTTypeDescription</key>
			<string>Prism Lighting Project</string>
			<key>UTTypeIconFile</key>
			<string>AppIcon</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>prismlights</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-prism-lights</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- prismlights:// deep links (e.g. prismlights://look/Chill%20Vibes) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.goveaaron.PrismLighting</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>prismlights</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
